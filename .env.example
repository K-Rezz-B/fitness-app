# Connexion Postgres (fournie automatiquement par l'intégration Neon de Vercel)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Mot de passe pour entrer dans l'app
APP_PASSWORD=change-moi
# Secret de signature de session (≥ 32 caractères aléatoires) : openssl rand -hex 32
AUTH_SECRET=
# Jeton secret du flux calendrier (≥ 16 caractères) : openssl rand -hex 16
CALENDAR_TOKEN=
# Fuseau horaire (défaut Europe/Paris)
APP_TIMEZONE=Europe/Paris
