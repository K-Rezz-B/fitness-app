# Connexion Postgres (fournie automatiquement par l'intégration Neon de Vercel)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Mot de passe pour entrer dans l'app
APP_PASSWORD=change-moi
# Secret de signature de session (≥ 32 caractères aléatoires) : openssl rand -hex 32
AUTH_SECRET=
# Jeton secret du flux calendrier (≥ 16 caractères) : openssl rand -hex 16
CALENDAR_TOKEN=
# Fuseau horaire (défaut Europe/Paris)
APP_TIMEZONE=Europe/Paris
# Notifications push (Web Push) : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact exigé par Apple/Google pour le push (mailto: ou https://), défaut : URL de prod Vercel
VAPID_SUBJECT=mailto:toi@example.com
# Secret du cron quotidien des notifications (Vercel l'envoie en Bearer) : openssl rand -hex 16
CRON_SECRET=
